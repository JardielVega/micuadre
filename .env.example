PORT=3000
NODE_ENV=development
# Conexión a PostgreSQL (con docker compose ya funciona tal cual)
DATABASE_URL=postgres://tienda:tienda@localhost:5432/tienda
# Base de datos separada para los tests (npm test)
DATABASE_URL_TEST=postgres://tienda:tienda@localhost:5432/tienda_test
# Texto largo y aleatorio. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Pon true si tu proveedor de PostgreSQL exige SSL (Neon, Render, Supabase...)
DB_SSL=false
