<dialog id="confirm-dialog" class="confirm m-auto w-[calc(100%-2rem)] max-w-sm rounded-lg border border-line bg-surface p-0 text-ink shadow-[0_24px_60px_-16px_rgb(14_15_17/0.45)]" aria-labelledby="confirm-message">
  <form method="dialog" class="p-5">
    <p id="confirm-message" class="text-[15px] font-medium leading-snug"></p>
    <p id="confirm-detail" class="mt-1.5 hidden text-sm text-muted"></p>
    <div class="mt-5 flex justify-end gap-2">
      <button value="cancel" class="btn btn-quiet btn-sm">Cancelar</button>
      <button value="ok" id="confirm-ok" class="btn btn-ink btn-sm">Continuar</button>
    </div>
  </form>
</dialog>
