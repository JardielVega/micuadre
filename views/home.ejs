<div class="grid min-h-[100dvh] lg:h-[100dvh] lg:grid-cols-[1.15fr_1fr]">
  <section class="flex flex-col justify-between gap-6 border-b border-line bg-raised px-6 py-8 sm:px-12 lg:border-b-0 lg:border-r lg:py-12">
    <%- include('partials/brand') %>

    <!-- Ilustración "trending-up" de Tabler Icons (MIT). Se dibuja sola al cargar la página. -->
    <div class="flex min-h-0 flex-1 items-center justify-center py-4 text-accent lg:justify-start lg:pl-8" aria-hidden="true">
      <svg class="draw size-36 sm:size-44 lg:size-[min(19rem,30dvh)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
        <path class="draw-line" pathLength="1" d="M3 17l6 -6l4 4l8 -8" />
        <path class="draw-head" pathLength="1" d="M14 7l7 0l0 7" />
      </svg>
    </div>

    <div class="max-w-xl">
      <h1 class="text-[2.75rem] font-semibold leading-[1.02] tracking-tighter sm:text-6xl">El cuadre del día, sin papeles.</h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-muted">
        Inventario, ventas y ganancias en un solo lugar. El dependiente vende y el jefe cuadra al cierre del día.
      </p>
    </div>
  </section>

  <section class="flex items-center px-6 py-12 sm:px-12">
    <div class="w-full max-w-md" data-stagger>
      <h2 class="text-xl">¿Quién eres?</h2>

      <div class="mt-6 border-y border-line">
        <a href="/auth/dependiente" class="choice flex items-center gap-4 border-b border-line py-5 pl-1 pr-2 transition-colors duration-150">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-line-strong bg-surface"><%- icon('shopping-cart-simple', 'size-[22px]') %></span>
          <span class="min-w-0 flex-1">
            <span class="block text-[17px] font-medium">Soy dependiente</span>
            <span class="block text-sm text-muted">Entro con el usuario que me dio el jefe.</span>
          </span>
          <span class="choice-arrow text-faint transition-[transform,color] duration-200 ease-out"><%- icon('arrow-right', 'size-5') %></span>
        </a>
        <a href="/auth/jefe" class="choice flex items-center gap-4 py-5 pl-1 pr-2 transition-colors duration-150">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-line-strong bg-surface"><%- icon('storefront', 'size-[22px]') %></span>
          <span class="min-w-0 flex-1">
            <span class="block text-[17px] font-medium">Soy jefe</span>
            <span class="block text-sm text-muted">Inicio sesión o creo el perfil de mi tienda.</span>
          </span>
          <span class="choice-arrow text-faint transition-[transform,color] duration-200 ease-out"><%- icon('arrow-right', 'size-5') %></span>
        </a>
      </div>
    </div>
  </section>
</div>
